# Contas e campanhas (Supabase). Sem estas variáveis o app funciona só localmente.
# Use a URL do projeto e a chave pública (anon/publishable), nunca a service_role.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "demo" ativa um servidor simulado no navegador, sem Supabase (só para testes).
# Equivale a `npm run dev:demo`.
VITE_BACKEND=
