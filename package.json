{
  "name": "tormenta-wiki",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/prepare-pdf.mjs",
    "dev": "vite --host 127.0.0.1",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "prebuild": "node scripts/prepare-pdf.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:campaigns": "playwright test -c playwright.campaigns.config.ts",
    "sources": "node scripts/extract-sources.mjs && node scripts/format-book.mjs",
    "sources:format": "node scripts/format-book.mjs",
    "maps:prepare": "node scripts/prepare-maps.mjs"
  },
  "dependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "dexie": "^4.2.0",
    "dexie-react-hooks": "^4.2.0",
    "fflate": "^0.8.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@playwright/test": "^1.58.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "fake-indexeddb": "^6.2.0",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.0"
  }
}
